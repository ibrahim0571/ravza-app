{
  "appId": "com.ibrahimaktas.ravza",
  "appName": "Ravza",
  "webDir": "www",
  "server": {
    "url": "https://tesbihat.ibrahimaktas.com",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "tesbihat.ibrahimaktas.com",
      "*.ibrahimaktas.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0e6b58",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0e6b58"
    }
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0e6b58"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0e6b58"
  }
}
